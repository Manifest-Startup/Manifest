{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend/app"
  ],
  "workbench.colorTheme": "Visual Studio Light - C++",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Default Dark Modern",
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  "search.exclude": {
    "**/node_modules": false
  },
  "cursorpyright.analysis.extraPaths": [
    "${workspaceFolder}/backend/app"
  ],
  "markdown.styles": [
    ".vscode/markdown.css"
  ],
  "markdown.preview.fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif",
  "markdown.preview.fontSize": 17,
  "markdown.preview.lineHeight": 1.62,
  "markdown.preview.typographer": true
}
