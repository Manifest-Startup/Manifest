{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "com.manifeststartup/manifest",
  "title": "Manifest",
  "version": "2.0.0",
  "description": "Turn a startup idea into an investable plan: ideas, documents, pitch shorts, messages, investments and your account. Sign in with OAuth; an API key gives the small REST toolset.",
  "websiteUrl": "https://manifeststartup.com/agents.md",
  "icons": [
    {
      "src": "https://manifeststartup.com/logo512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Manifest-Startup/Manifest",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://manifeststartup.com/mcp",
      "supportedProtocolVersions": [
        "2025-03-26",
        "2025-06-18",
        "2025-11-25"
      ],
      "authentication": {
        "type": "oauth2",
        "protectedResourceMetadata": "https://manifeststartup.com/.well-known/oauth-protected-resource/mcp"
      }
    }
  ]
}
