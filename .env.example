# Copy to .env and fill in values. For local demo (no keys), you can leave this file empty
# or copy only the lines you need—demo mode + in-memory DB work without Supabase/Postgres.
# Migration runbook: docs/MIGRATION_FROM_REPLIT.md

# --- Core runtime ---
ENVIRONMENT=development
# APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
# HOST and PORT are not read by uvicorn in main.py; pass to the process manager instead.
HOST=0.0.0.0
PORT=8000

# --- Database (required for production; omit for local demo in-memory mode) ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# USE_IN_MEMORY_DB=1
# ASYNC_DB=true
# DB_POOL_MIN_CONNECTIONS=2
# DB_POOL_MAX_CONNECTIONS=10

# --- Session / auth (required in production-like environments) ---
# SESSION_SECRET=
# APP_BASE_URL=http://localhost:3000
# DEMO_MODE=false

# --- CORS / hosts (backend reads FRONTEND_ORIGINS in main.py; CORS_ORIGINS here is legacy/unused) ---
# FRONTEND_ORIGINS=https://your-app.vercel.app,https://manifeststartup.com
# ALLOWED_HOSTS=
# Replit-only (keep on Replit; unset on Render/Vercel):
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
# REPLIT_DEV_DOMAIN=
# REPLIT_DOMAINS=

# --- Supabase (storage + future DB target; optional for local demo) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# --- OpenAI / AI (optional in demo; AI features disabled if unset) ---
# OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# PITCH_DECK_WEB_RESEARCH=1
VOICE_AGENT_MODEL=gpt-4o
VOICE_AGENT_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Current steerable speech model; sentence chunking and prefetch remain enabled.
VOICE_AGENT_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
VOICE_AGENT_TTS_VOICE=nova
# Realtime (speech-to-speech) voice over WebRTC — near-instant + native barge-in.
# OFF by default: Realtime audio is materially more expensive than the streaming TTS pipeline.
# When false, the client transparently uses the streaming TTS pipeline above.
VOICE_REALTIME_ENABLED=false
VOICE_REALTIME_MODEL=gpt-4o-realtime-preview
# Realtime voices differ from TTS voices (no `nova`); shimmer is a warm female default.
VOICE_REALTIME_VOICE=shimmer
VOICE_REALTIME_ALLOW_GUESTS=false

# --- Email (password reset; logs to console if unset) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@manifeststartup.com

# --- Analytics ---
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# --- Open Media (Messages and Pitch Shorts; docs/adr/0001) ---
# Off by default: Messages and Pitch Shorts are hidden and Open Media/Veo are never called.
# OPEN_MEDIA_ENABLED=false
# OPEN_MEDIA_API_BASE=https://api.openmedia.site
# OPEN_MEDIA_CLIENT_ID=https://manifeststartup.com/oauth/open-media-client.json
# Only for a local Open Media stack (must be listed in the client document):
# OPEN_MEDIA_REDIRECT_URI=https://manifeststartup.com/api/integrations/open-media/callback
# Secret (same value as APP_WEBHOOKS.manifest.secret on the Open Media Worker):
# OPEN_MEDIA_WEBHOOK_SECRET=

# --- Pitch reel video (optional; needs OPEN_MEDIA_ENABLED) ---
# GOOGLE_API_KEY=
# GEMINI_VIDEO_MODEL=
# PITCH_REEL_VIDEO_MODE=thread

# --- Render / Uvicorn (production backend on Render) ---
# UVICORN_FORWARDED_ALLOW_IPS=10.0.0.0/8
# METRICS_ENABLED=true

# --- Frontend build-time (set in Vercel, not backend .env) ---
# REACT_APP_GRAPHQL_URL=
# REACT_APP_PUBLIC_POSTHOG_KEY=
# REACT_APP_PUBLIC_POSTHOG_HOST=
# REACT_APP_VERSION=
# REACT_APP_SILENT_LOGGER=

# --- Cursor MCP (local tooling only) ---
# RENDER_API_KEY=

# --- Internal / optional ---
# MANIFEST_AGENT_LOOP_SECRET=
# MANIFEST_GITHUB_TOKEN=
# MANIFEST_GITHUB_REPO=Manifest-Startup/Manifest
