{
  // Manifest edge: the single production Worker for manifeststartup.com.
  // Serves the React build from Cloudflare's edge and forwards backend paths
  // to BACKEND_ORIGIN (the FastAPI Docker image, currently on Render free).
  // Changing backend host = change BACKEND_ORIGIN and redeploy. See
  // Cloudflare Worker and asset routing for manifeststartup.com.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manifest-production",
  "main": "src/index.mjs",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "../../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Keep in sync with BACKEND_PREFIXES in src/edge.mjs.
    "run_worker_first": [
      "/",
      "/home",
      "/research",
      "/feedback/survey",
      "/ideas",
      "/ideas/*",
      "/account",
      "/account/billing",
      "/admin/cost",
      "/login",
      "/signup",
      "/learn-more",
      "/messages",
      "/messages/*",
      "/pitch-reels",
      "/shorts",
      "/discover",
      "/pitch-shorts",
      "/portfolio",
      "/docs",
      "/docs/guide",
      "/docs/api",
      "/docs/mcp",
      "/auth.md",
      "/pricing",
      "/legal/terms",
      "/legal/privacy",
      "/about",
      "/contact",
      "/privacy",
      "/developers",
      "/mcp",
      "/graphql",
      "/graphql/*",
      "/socket.io/*",
      "/api/*",
      "/auth/*",
      "/scim/*",
      "/trust",
      "/ping",
      "/health",
      "/healthz",
      "/__ora/status",
      "/generated/*",
      "/openapi.json",
      "/.well-known/*",
      "/agents.md",
      "/AGENTS.md",
      "/pricing.md",
      "/schema-map.xml",
      "/structured-data.jsonl",
      "/index.md",
      "/about.md",
      "/contact.md",
      "/docs.md",
      "/docs/api.md",
      "/privacy.md",
      "/legal/privacy.md",
      "/legal/terms.md",
      "/internal/*"
    ]
  },
  // Secret (not here): EDGE_SHARED_SECRET via `wrangler secret put`; same value
  // as the backend's EDGE_SHARED_SECRET so the origin only accepts edge traffic.
  "vars": {
    "BACKEND_ORIGIN": "https://manifest-backend-dz6t.onrender.com",
    "ORA_DOMAIN_ID": "cd0f6671-8a80-40df-83a7-3cd2d0d5a6e2",
    // Supabase public storage base, e.g. https://<ref>.supabase.co/storage/v1/object/public
    // Empty = legacy /generated/pdfs/* URLs are served by the backend.
    "FILES_PUBLIC_BASE": "https://lvwmgkgokmaxgecvkwap.supabase.co/storage/v1/object/public"
  },
  // Keeps a free-tier backend awake (Render free sleeps after 15 idle minutes).
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
